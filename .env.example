# Copy this file to .env for local development.
SECRET_KEY=local-development-only-replace-this-key-before-deployment-0123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Docker Compose uses these values to create the PostgreSQL database.
DB_NAME=studio
DB_USER=studio
DB_PASSWORD=studio_local_password

# Host development uses this URL. Compose overrides DB_HOST and DB_PORT
# for the app container, keeping the credentials and database from this URL.
DATABASE_URL=postgresql://studio:studio_local_password@localhost:5423/studio
